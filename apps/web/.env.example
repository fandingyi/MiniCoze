VITE_API_BASE_URL=/api
VITE_API_PROXY_PREFIX=/api
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_USE_AUTH_MOCK=true

# Optional Go migration target; unset keeps all requests on NestJS.
VITE_GO_API_PROXY_TARGET=
# Enable only after Go persisted/public routes are ready.
VITE_GO_PUBLIC_PROXY_ENABLED=false




