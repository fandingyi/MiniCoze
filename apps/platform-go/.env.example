# Supply these through environment variables; no secrets are committed.
GO_ADDR=127.0.0.1:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/minicoze?schema=public
# Must match NestJS JWT_SECRET during migration; do not use this placeholder.
JWT_SECRET=
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional. If omitted, the SSE bridge is disabled (404).
NESTJS_INTERNAL_URL=http://127.0.0.1:3000
# Optional day-3 stateless preview gateway (separate from persisted chats).
PYTHON_RUNTIME_URL=http://127.0.0.1:8001
# Must match Python Runtime, at least 32 characters; never a user JWT.
RUNTIME_SERVICE_TOKEN=

# Enable after applying day-4 Prisma migration; false keeps NestJS bridge.
GO_PERSISTED_RUNS=false
# Persisted run budget (maximum 120s) and per-instance admission limit (1..256).
GO_RUN_TIMEOUT=120s
GO_RUN_MAX_CONCURRENT=32
GO_PUBLIC_MAX_CONCURRENT=4

# Day 7: opt-in published WEB/API routes; requires GO_PERSISTED_RUNS=true.
GO_PUBLIC_RUNS=false
# Boolean switches accept exactly true/false; public requires persisted mode.
# Separate random secret, at least 32 characters. Shared across Go instances.
PUBLIC_SESSION_SECRET=
# Keep true behind HTTPS. Set false only for local HTTP development.
PUBLIC_COOKIE_SECURE=true
