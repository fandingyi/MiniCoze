# Set environment variables before starting; .env is not loaded automatically.
RUNTIME_SERVICE_TOKEN=
# Fixed trusted provider endpoint. This value never comes from a client request.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# Comma-separated model identifiers matching Agent configuration.
MODEL_ALLOWLIST=
# Required for persisted draft tool calls; fixed trusted Go origin, not a model URL.
GO_TOOL_GATEWAY_URL=http://127.0.0.1:3001
